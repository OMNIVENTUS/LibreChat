{
    "openapi": "3.0.0",
    "info": {
        "title": "TextGears Content Analysis API",
        "description": "API for comprehensive content analysis including grammar checking, readability metrics, and SEO suggestions",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "https://api.textgears.com",
            "description": "TextGears API Server"
        }
    ],
    "paths": {
        "/analyze": {
            "post": {
                "summary": "Comprehensive text analysis",
                "description": "Analyzes text for grammar, readability, emotion, and provides detailed metrics",
                "operationId": "analyzeContent",
                "parameters": [
                    {
                        "name": "key",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Your TextGears API key"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "The content to analyze"
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Language code for analysis (e.g., en-US, en-GB)",
                                        "default": "en-US"
                                    },
                                    "ai": {
                                        "type": "boolean",
                                        "description": "Use TextGears AI to improve analysis quality",
                                        "default": true
                                    },
                                    "whitelist": {
                                        "type": "array",
                                        "description": "Words to ignore during analysis",
                                        "items": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful analysis",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "description": "Success status of the request"
                                        },
                                        "response": {
                                            "type": "object",
                                            "properties": {
                                                "grammar": {
                                                    "type": "object",
                                                    "properties": {
                                                        "errors": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "id": {
                                                                        "type": "string",
                                                                        "description": "Unique error ID"
                                                                    },
                                                                    "offset": {
                                                                        "type": "integer",
                                                                        "description": "Error text offset"
                                                                    },
                                                                    "length": {
                                                                        "type": "integer",
                                                                        "description": "Error text length"
                                                                    },
                                                                    "bad": {
                                                                        "type": "string",
                                                                        "description": "The text containing the error"
                                                                    },
                                                                    "description": {
                                                                        "type": "string",
                                                                        "description": "Description of the error"
                                                                    },
                                                                    "better": {
                                                                        "type": "array",
                                                                        "description": "Suggested corrections",
                                                                        "items": {
                                                                            "type": "string"
                                                                        }
                                                                    },
                                                                    "type": {
                                                                        "type": "string",
                                                                        "description": "Type of error (e.g., grammar, spelling)"
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                },
                                                "stats": {
                                                    "type": "object",
                                                    "properties": {
                                                        "fleschKincaid": {
                                                            "type": "object",
                                                            "properties": {
                                                                "readingEase": {
                                                                    "type": "number",
                                                                    "description": "Flesch-Kincaid reading ease score"
                                                                },
                                                                "grade": {
                                                                    "type": "string",
                                                                    "description": "Grade level of text"
                                                                },
                                                                "interpretation": {
                                                                    "type": "string",
                                                                    "description": "Interpretation of the reading ease"
                                                                }
                                                            }
                                                        },
                                                        "gunningFog": {
                                                            "type": "number",
                                                            "description": "Gunning Fog Index score"
                                                        },
                                                        "colemanLiau": {
                                                            "type": "number",
                                                            "description": "Coleman-Liau Index score"
                                                        },
                                                        "SMOG": {
                                                            "type": "number",
                                                            "description": "SMOG Index score"
                                                        },
                                                        "vocabularySize": {
                                                            "type": "object",
                                                            "properties": {
                                                                "active": {
                                                                    "type": "integer",
                                                                    "description": "Estimated active vocabulary size",
                                                                    "nullable": true
                                                                },
                                                                "passive": {
                                                                    "type": "integer",
                                                                    "description": "Estimated passive vocabulary size",
                                                                    "nullable": true
                                                                }
                                                            }
                                                        },
                                                        "emotion": {
                                                            "type": "object",
                                                            "properties": {
                                                                "positive": {
                                                                    "type": "number",
                                                                    "description": "Positive emotion score (0-1)"
                                                                },
                                                                "negative": {
                                                                    "type": "number",
                                                                    "description": "Negative emotion score (0-1)"
                                                                }
                                                            }
                                                        },
                                                        "counters": {
                                                            "type": "object",
                                                            "properties": {
                                                                "length": {
                                                                    "type": "integer",
                                                                    "description": "Total character length"
                                                                },
                                                                "clearLength": {
                                                                    "type": "integer",
                                                                    "description": "Length without special characters"
                                                                },
                                                                "words": {
                                                                    "type": "integer",
                                                                    "description": "Word count"
                                                                },
                                                                "sentences": {
                                                                    "type": "integer",
                                                                    "description": "Sentence count"
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "error_code": {
                                            "type": "integer"
                                        },
                                        "description": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized (invalid key)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "error_code": {
                                            "type": "integer",
                                            "example": 600
                                        },
                                        "description": {
                                            "type": "string",
                                            "example": "Invalid license key"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/grammar": {
            "post": {
                "summary": "Grammar checking",
                "description": "Checks text for grammatical, spelling, and punctuation errors",
                "operationId": "checkGrammar",
                "parameters": [
                    {
                        "name": "key",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Your TextGears API key"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "The content to check"
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Language code (e.g., en-US, en-GB)",
                                        "default": "en-US"
                                    },
                                    "ai": {
                                        "type": "boolean",
                                        "description": "Use TextGears AI to improve analysis",
                                        "default": true
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful grammar check",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean"
                                        },
                                        "response": {
                                            "type": "object",
                                            "properties": {
                                                "errors": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "object",
                                                        "properties": {
                                                            "id": {
                                                                "type": "string"
                                                            },
                                                            "offset": {
                                                                "type": "integer"
                                                            },
                                                            "length": {
                                                                "type": "integer"
                                                            },
                                                            "bad": {
                                                                "type": "string"
                                                            },
                                                            "better": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string"
                                                                }
                                                            },
                                                            "type": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/readability": {
            "post": {
                "summary": "Readability metrics",
                "description": "Calculates various readability metrics and text statistics",
                "operationId": "checkReadability",
                "parameters": [
                    {
                        "name": "key",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Your TextGears API key"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "The content to analyze"
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Language code (e.g., en-US)",
                                        "default": "en-US"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful readability analysis",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean"
                                        },
                                        "response": {
                                            "type": "object",
                                            "properties": {
                                                "stats": {
                                                    "type": "object",
                                                    "properties": {
                                                        "fleschKincaid": {
                                                            "type": "object",
                                                            "properties": {
                                                                "readingEase": {
                                                                    "type": "number"
                                                                },
                                                                "grade": {
                                                                    "type": "string"
                                                                },
                                                                "interpretation": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        },
                                                        "gunningFog": {
                                                            "type": "number"
                                                        },
                                                        "colemanLiau": {
                                                            "type": "number"
                                                        },
                                                        "SMOG": {
                                                            "type": "number"
                                                        },
                                                        "emotion": {
                                                            "type": "object",
                                                            "properties": {
                                                                "positive": {
                                                                    "type": "number"
                                                                },
                                                                "negative": {
                                                                    "type": "number"
                                                                }
                                                            }
                                                        },
                                                        "counters": {
                                                            "type": "object",
                                                            "properties": {
                                                                "length": {
                                                                    "type": "integer"
                                                                },
                                                                "clearLength": {
                                                                    "type": "integer"
                                                                },
                                                                "words": {
                                                                    "type": "integer"
                                                                },
                                                                "sentences": {
                                                                    "type": "integer"
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/summarize": {
            "post": {
                "summary": "Summarization and keyword extraction",
                "description": "Extracts key information and important keywords from text",
                "operationId": "summarizeContent",
                "parameters": [
                    {
                        "name": "key",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Your TextGears API key"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "text"
                                ],
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "The content to summarize"
                                    },
                                    "language": {
                                        "type": "string",
                                        "description": "Language code (e.g., en-US)",
                                        "default": "en-US"
                                    },
                                    "max_sentences": {
                                        "type": "integer",
                                        "description": "Maximum number of sentences in summary"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful summarization",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "boolean"
                                        },
                                        "response": {
                                            "type": "object",
                                            "properties": {
                                                "keywords": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "highlight": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                },
                                                "summary": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "ApiKeyQuery": {
                "type": "apiKey",
                "in": "query",
                "name": "key"
            }
        }
    }
}